# === 鍵の記入見本 ===
# このファイルをコピーして「keys.local」という名前にして、
# 下の右側（=の後ろ）をあなたの値に書き換えてください。
# ※ keys.local はGitHubには上がりません（.gitignoreで除外済み）。

# 楽天Developersで発行する applicationId（数字の長い列）
RAKUTEN_APP_ID=ここにapplicationIdを貼る

# 楽天アフィリエイトID（Rakuten Developersのアプリ画面に表示される値）
RAKUTEN_AFFILIATE_ID=565ae11c.a4a96be2.565ae11d.fa900aba
