# Claude API キー（記事の自動生成に使用）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# 記事生成に使うモデル（未指定なら claude-opus-5）
# コストを抑えたい場合は claude-sonnet-5 に変更
NOTE_AUTO_MODEL=claude-opus-5

# note のログイン情報（メール＋パスワードでログインする場合）
# Googleログインを使っている場合は、初回だけ手動ログイン方式を推奨（README参照）
NOTE_EMAIL=you@example.com
NOTE_PASSWORD=your-note-password
